#################################################################
# Recommendations
#################################################################

uce:RecommendationForArdaAI a uce:Recommendation ;
    rdfs:label "Recommendation for Arda - AI Workshop"@en ;
    uce:recommendedFor uce:ArdaStudent ;
    uce:recommendsEvent uce:AIWorkshop2026 .

uce:RecommendationForArdaPython a uce:Recommendation ;
    rdfs:label "Recommendation for Arda - Python Bootcamp"@en ;
    uce:recommendedFor uce:ArdaStudent ;
    uce:recommendsEvent uce:PythonBootcamp2026 .

uce:RecommendationForAyseRobotics a uce:Recommendation ;
